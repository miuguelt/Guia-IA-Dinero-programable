{
  "name": "guia-ia-dinero-programable",
  "version": "2.0.0",
  "description": "Aula local de IA y dinero programable con evaluación por reglas, Solidity y PostgreSQL para ADSO SENA",
  "main": "index.html",
  "scripts": {
    "compile": "hardhat compile",
    "test": "npm run test:unit && npm run test:contracts",
    "test:unit": "node --require ./scripts/load-env.cjs --test --test-concurrency=1 tests/backend/*.test.cjs tests/frontend/*.test.mjs",
    "test:legacy": "node --test tests/*.test.mjs",
    "test:contracts": "hardhat test",
    "test:integration": "node --require ./scripts/load-env.cjs --test tests/integration/*.test.cjs",
    "test:browser": "node --require ./scripts/load-env.cjs --test tests/browser/*.test.cjs",
    "test:taller": "node --require ./scripts/load-env.cjs --test tests/taller/*.test.cjs",
    "coverage": "c8 --all --include=backend/**/*.cjs --include=frontend/web/**/*.js --include=frontend/web/**/*.mjs --include=scripts/**/*.cjs --include=scripts/deploy.js --include=hardhat.config.js --reporter=text --reporter=json-summary --reporter=lcov --check-coverage --functions=100 node scripts/run-coverage.cjs",
    "coverage:contracts": "hardhat coverage && node scripts/check-solidity-coverage.cjs",
    "build": "node scripts/build-web.cjs",
    "start": "node backend/server.cjs",
    "dev": "node scripts/dev.cjs",
    "node": "node scripts/chain-node.cjs",
    "deploy": "hardhat run scripts/deploy.js --network localhost",
    "local:start": "pwsh -NoProfile -File start-windows.ps1",
    "local:stop": "pwsh -NoProfile -File start-windows.ps1 -Stop"
  },
  "keywords": [
    "blockchain",
    "smart-contracts",
    "solidity",
    "hardhat",
    "dinero-programable",
    "sena-adso"
  ],
  "author": "Tecnólogo ADSO SENA",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@nomicfoundation/hardhat-toolbox": "5.0.0",
    "c8": "12.0.0",
    "esbuild": "0.28.2",
    "hardhat": "2.29.1",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "solc": "0.8.24",
    "solidity-coverage": "0.8.17"
  },
  "overrides": {
    "ethers": "$ethers",
    "ws": "8.21.0",
    "snarkjs": "0.7.6",
    "underscore": "1.13.8"
  },
  "dependencies": {
    "@semaphore-protocol/contracts": "4.14.5",
    "@semaphore-protocol/core": "4.14.5",
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "14.0.3",
    "ethers": "6.17.0",
    "pg": "8.23.1"
  }
}
