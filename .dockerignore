# --- DevBrain baseline: never ship VCS or secrets into an image ---
.git
.gitignore
.gitattributes
.github
.env
.env.*
!.env.example
*.pem
*.key
*.pfx

# --- DevBrain baseline: editor and IDE state ---
.vscode
.idea
.antigravityrules

# --- DevBrain baseline: build-irrelevant content ---
*.md
!README.md
docs/
tests/
logs/
tmp/
coverage/
scratch/

# --- DevBrain baseline: fossils and quarantine ---
_archive/
_graveyard/
backups/
vault/
*.bak
*.bak-*
*_OLD*

# --- DevBrain baseline: override local de Compose (nunca se versiona) ---
docker-compose.override.yml

# --- Sitio estatico: fuentes de diseno, nunca el codigo del build ---
*.psd
*.ai
*.fig
*.sketch
*.xcf
design/
mockups/

