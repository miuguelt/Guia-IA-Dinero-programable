# --- DevBrain baseline: secrets (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
secrets.json
credentials.json

# --- DevBrain baseline: local noise ---
.DS_Store
Thumbs.db
*.log
logs/
tmp/
.cache/
coverage/

# --- DevBrain baseline: throwaway scripts (main credential leak vector) ---
scratch/
debug_*.py
debug_*.ps1
debug_*.js

# --- DevBrain baseline: fossils and quarantine (policy: never live in a repo) ---
_archive/
_graveyard/
backups/
vault/
*.bak
*.bak-*
*_OLD*

# --- DevBrain baseline: override local de Compose (nunca se versiona) ---
docker-compose.override.yml

# --- Sitio estatico ---
.sass-cache/
*.css.map
*.js.map

